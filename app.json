{
  "expo": {
    "name": "HabitHatch",
    "slug": "habithatch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon/logo-paw.png",
    "userInterfaceStyle": "light",
    "scheme": "habithatch",
    "android": {
      "package": "com.habithatch.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/logo-paw.png",
        "backgroundColor": "#0C4C60"
      },
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID"
      ],
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.habithatch.app"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon/logo-paw.png",
          "resizeMode": "contain",
          "backgroundColor": "#0C4C60"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.margelo.nitro.** { *; }\n"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "HabitHatch uses your photos only to set your profile picture."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#0C4C60"
        }
      ]
    ]
  }
}
